# Application authentication. Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
DEMO_EMAIL=admin@example.com
DEMO_PASSWORD=prototype

# Bootstrap API key. Additional revocable keys can be created in the ProtoShelf UI.
PROTOSHELF_API_KEY=replace-with-a-long-random-api-key

# Supabase server credentials. Never expose the service-role key through NEXT_PUBLIC_*.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
